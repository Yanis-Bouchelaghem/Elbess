  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.28.2",
  "private": true,
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "eslint": "^10.8.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.67.0"
  },
  "type": "module"
}
